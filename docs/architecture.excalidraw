      "isDeleted": false,
      "boundElements": [],
      "updated": 1793468875785,
      "link": null,
      "locked": false,
      "text": "Reciprocal Rank Fusion, k = 60\nKey = video + 10s bucket. Each list votes once per bucket with 1 / (60 + rank)\nFuses by rank because scores can't be compared across lists",
      "originalText": "Reciprocal Rank Fusion, k = 60\nKey = video + 10s bucket. Each list votes once per bucket with 1 / (60 + rank)\nFuses by rank because scores can't be compared across lists",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rrf",
      "autoResize": true,
      "lineHeight": 1.25
    },

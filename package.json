{
  "name": "video-search",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --continue=always",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun --env-file=.env scripts/migrate.ts",
    "kafka:setup": "bun --env-file=.env scripts/create-topics.ts",
    "spike": "bun --env-file=.env apps/workers/scripts/spike.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@app/shared": "workspace:*"
  }
}

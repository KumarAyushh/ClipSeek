# Copy to .env and fill in real values:  cp .env.example .env
# This file holds placeholders only. Never put real values here.

# Postgres (used by docker-compose.yml and the apps)
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database>
DATABASE_URL=postgres://<postgres-user>:<postgres-password>@<host>:<port>/<postgres-database>

# Kafka
KAFKA_BROKERS=<host>:<port>
KAFKA_TOPIC_VIDEO_UPLOADED=<topic-name>

# Where uploaded videos and thumbnails go (relative paths resolve from the repo root)
STORAGE_DIR=<path-to-storage-dir>

API_PORT=<port>

# Hugging Face model ids, run locally with transformers.js
CLIP_MODEL=<clip-model-id>
WHISPER_MODEL=<whisper-model-id>
TEXT_EMBED_MODEL=<text-embedding-model-id>
CLAP_MODEL=<clap-model-id>
